            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Complete a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{id}/abort": {
      "post": {
        "description": "Discards the multipart upload and marks the draft as errored. The row is kept for audit.",
        "operationId": "VideosController_abortUpload",
