              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get public video metadata",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{public_id}/stream": {
      "get": {
        "description": "Redirects (302) to a presigned storage URL. The player follows it and issues range requests directly against storage, so playback starts without transferring the whole file and the API never carries video bytes.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "public_id",
            "required": true,
            "in": "path",
            "description": "Public identifier of the video, as returned when it was created.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the presigned playback URL",
            "headers": {
              "Location": {
                "description": "Presigned storage URL",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Video not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not ready for playback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Object storage unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Stream a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{public_id}/download": {
      "get": {
        "description": "Requires authentication — downloading is a user action, while watching is open to anonymous visitors. Redirects (302) to a presigned URL signed as an attachment.",
        "operationId": "VideosController_download",
        "parameters": [
          {
            "name": "public_id",
            "required": true,
            "in": "path",
            "description": "Public identifier of the video, as returned when it was created.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the presigned download URL",
            "headers": {
              "Location": {
                "description": "Presigned storage URL with an attachment disposition",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not ready for playback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Object storage unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Download a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{public_id}/thumbnail": {
      "get": {
        "description": "Redirects (302) to a presigned URL for the generated JPEG. Returns 404 while the video has no thumbnail yet.",
        "operationId": "VideosController_thumbnail",
        "parameters": [
          {
            "name": "public_id",
            "required": true,
            "in": "path",
            "description": "Public identifier of the video, as returned when it was created.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the presigned thumbnail URL",
            "headers": {
              "Location": {
                "description": "Presigned storage URL",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Video not found, or no thumbnail yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get a video thumbnail",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{public_id}/playback-url": {
      "get": {
        "description": "Issues a fresh presigned playback URL, so a player can recover after its previous URL expires.",
        "operationId": "VideosController_playbackUrl",
        "parameters": [
          {
            "name": "public_id",
            "required": true,
            "in": "path",
            "description": "Public identifier of the video, as returned when it was created.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fresh presigned playback URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoPlaybackUrlResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Video not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not ready for playback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Refresh a playback URL",
        "tags": [
          "videos"
        ]
      }
    }
  },
