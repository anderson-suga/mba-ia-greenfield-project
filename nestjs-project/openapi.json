          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Internal video id returned when the upload was initiated.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteUploadDto"
